# Copy this file to .env and fill in your EmailJS values
# Get these from https://www.emailjs.com dashboard
VITE_EMAILJS_SERVICE_ID=service_your_service_id
VITE_EMAILJS_TEMPLATE_ID=template_your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Backend API URL for production (separate Vercel backend project).
# Leave empty in local dev (Vite proxies /api -> localhost:5000).
# Example: https://bfhs-api.vercel.app/api
VITE_API_URL=
